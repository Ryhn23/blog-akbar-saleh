<%- include('partials/header', { title: typeof t !== 'undefined' ? t('page_not_found') : 'Halaman Tidak Ditemukan' }) %>

<section class="py-24 bg-white min-h-[70vh] flex items-center justify-center text-center" <%- (typeof isRtl !== 'undefined' && isRtl) ? 'dir="rtl"' : '' %>>
    <div class="max-w-md mx-auto px-4">
        <span class="text-7xl font-serif font-black text-emerald-900 block mb-3">404</span>
        <h1 class="text-xl font-serif font-bold text-gray-900 mb-2">
            <%= typeof t !== 'undefined' ? t('page_not_found') : 'Halaman Tidak Ditemukan' %>
        </h1>
        <p class="text-xs sm:text-sm text-gray-500 mb-6 leading-relaxed">
            <%= typeof t !== 'undefined' ? t('page_not_found_desc') : 'Halaman atau artikel yang Anda cari tidak tersedia atau telah dipindahkan.' %>
        </p>
        <a href="/<%= (typeof currentLang !== 'undefined' && currentLang !== 'id') ? '?lang=' + currentLang : '' %>" class="inline-flex items-center px-5 py-2 rounded-lg bg-emerald-800 text-white font-semibold text-xs hover:bg-emerald-900 transition">
            <%= typeof t !== 'undefined' ? t('back_to_home') : 'Kembali ke Beranda' %>
        </a>
    </div>
</section>

<%- include('partials/footer') %>
