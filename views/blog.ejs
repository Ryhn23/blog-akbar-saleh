<%- include('partials/header', { 
    title: typeof title !== 'undefined' ? title : 'Arsip Kajian & Tulisan Ilmiah',
    canonicalUrl: typeof canonicalUrl !== 'undefined' ? canonicalUrl : null,
    schemaJsonLd: typeof schemaJsonLd !== 'undefined' ? schemaJsonLd : null
}) %>

<section class="py-12 bg-white min-h-[75vh]" <%- (typeof isRtl !== 'undefined' && isRtl) ? 'dir="rtl"' : '' %>>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Header & Minimalist Search -->
        <div class="mb-10 pb-6 border-b border-gray-100">
            <h1 class="text-2xl sm:text-3xl font-serif font-bold text-gray-900 mb-2">
                <%= t('nav_blog') %>
            </h1>
            <p class="text-sm text-gray-500 mb-6">
                <%= t('hero_default_content') %>
            </p>

            <form action="/blog" method="GET" class="relative max-w-lg">
                <input 
                    type="text" 
                    name="q" 
                    value="<%= searchQuery %>" 
                    placeholder="<%= t('search_placeholder') %>" 
                    class="w-full pl-10 pr-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg text-xs sm:text-sm focus:outline-none focus:ring-1 focus:ring-emerald-700 focus:border-emerald-700 focus:bg-white transition"
                >
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                </div>
                <% if (selectedCategory) { %>
                    <input type="hidden" name="category" value="<%= selectedCategory %>">
                <% } %>
                <% if (typeof currentLang !== 'undefined' && currentLang !== 'id') { %>
                    <input type="hidden" name="lang" value="<%= currentLang %>">
                <% } %>
            </form>
        </div>

        <!-- Category Pills (Clean Green Theme) -->
        <% if (categories && categories.length > 0) { %>
            <div class="flex items-center flex-wrap gap-2 mb-8">
                <a 
                    href="/blog<%= (typeof currentLang !== 'undefined' && currentLang !== 'id') ? '?lang=' + currentLang + (searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '') : (searchQuery ? '?q=' + encodeURIComponent(searchQuery) : '') %>" 
                    class="px-3 py-1 rounded-md text-xs font-semibold transition <%= !selectedCategory ? 'bg-emerald-800 text-white' : 'bg-gray-100 text-gray-600 hover:bg-emerald-50 hover:text-emerald-800' %>"
                >
                    <%= t('all_categories') %>
                </a>
                <% categories.forEach(cat => { %>
                    <a 
                        href="/blog?category=<%= encodeURIComponent(cat.category) %><%= (typeof currentLang !== 'undefined' && currentLang !== 'id') ? '&lang=' + currentLang : '' %><%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %>" 
                        class="px-3 py-1 rounded-md text-xs font-medium transition <%= selectedCategory === cat.category ? 'bg-emerald-800 text-white font-semibold' : 'bg-gray-100 text-gray-600 hover:bg-emerald-50 hover:text-emerald-800' %>"
                    >
                        <%= cat.category %> (<%= cat.count %>)
                    </a>
                <% }) %>
            </div>
        <% } %>

        <!-- Active Filter Alert -->
        <% if (searchQuery || selectedCategory) { %>
            <div class="flex items-center justify-between bg-emerald-50 border border-emerald-100 text-emerald-900 px-4 py-2.5 rounded-lg mb-8 text-xs">
                <span>
                    Menampilkan hasil untuk 
                    <% if (selectedCategory) { %>kategori <strong>"<%= selectedCategory %>"</strong><% } %>
                    <% if (selectedCategory && searchQuery) { %> dan <% } %>
                    <% if (searchQuery) { %>pencarian <strong>"<%= searchQuery %>"</strong><% } %>
                    (<%= posts.length %> artikel)
                </span>
                <a href="/blog<%= (typeof currentLang !== 'undefined' && currentLang !== 'id') ? '?lang=' + currentLang : '' %>" class="font-bold text-emerald-800 hover:underline">Hapus Filter</a>
            </div>
        <% } %>

        <!-- Article Stream -->
        <div class="space-y-8 divide-y divide-gray-100">
            <% if (posts && posts.length > 0) { %>
                <% posts.forEach(post => { %>
                    <article class="pt-8 first:pt-0 group">
                        <div class="flex items-center gap-3 text-xs text-gray-500 mb-2">
                            <span class="text-emerald-800 font-semibold"><%= post.category || 'Kajian' %></span>
                            <span>•</span>
                            <time datetime="<%= post.created_at %>"><%= new Date(post.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %></time>
                            <span>•</span>
                            <span><%= post.reading_time || 1 %> <%= t('min_read') %></span>
                        </div>

                        <h2 class="text-lg sm:text-xl font-serif font-bold text-gray-900 mb-2 group-hover:text-emerald-800 transition leading-snug">
                            <a href="/blog/<%= post.slug %><%= (typeof currentLang !== 'undefined' && currentLang !== 'id') ? '?lang=' + currentLang : '' %>">
                                <%= post.title %>
                            </a>
                        </h2>

                        <p class="text-gray-600 text-sm leading-relaxed mb-3 line-clamp-2">
                            <%= post.meta_description || post.content.replace(/<[^>]+>/g, '').substring(0, 140) + '...' %>
                        </p>

                        <a href="/blog/<%= post.slug %><%= (typeof currentLang !== 'undefined' && currentLang !== 'id') ? '?lang=' + currentLang : '' %>" class="inline-flex items-center text-xs font-semibold text-emerald-800 hover:underline">
                            <%= t('read_more') %> →
                        </a>
                    </article>
                <% }) %>
            <% } else { %>
                <div class="text-center py-12 text-gray-400 bg-gray-50 rounded-xl border border-dashed border-gray-200">
                    <p class="text-sm">Tidak ditemukan tulisan yang cocok.</p>
                </div>
            <% } %>
        </div>

    </div>
</section>

<%- include('partials/footer') %>