<%- include('partials/header', { 
    title: '', 
    canonicalUrl: typeof canonicalUrl !== 'undefined' ? canonicalUrl : null,
    schemaJsonLd: typeof schemaJsonLd !== 'undefined' ? schemaJsonLd : null
}) %>

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
    
    <!-- Compact Header Intro -->
    <header class="pb-8 mb-8 border-b border-gray-100">
        <% if (typeof heroBadge !== 'undefined' && heroBadge && heroBadge.trim()) { %>
        <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-800 text-xs font-medium border border-emerald-100 mb-3">
            <span><%= heroBadge %></span>
        </div>
        <% } %>

        <h1 class="text-2xl sm:text-3xl md:text-4xl font-serif font-bold text-gray-900 tracking-tight leading-snug mb-3">
            <%- typeof heroTitle !== 'undefined' && heroTitle ? heroTitle : 'Catatan, Kajian Ilmiah & <span class="text-emerald-800">Pemikiran Keislaman</span>' %>
        </h1>

        <div class="text-sm sm:text-base text-gray-600 leading-relaxed max-w-3xl font-light">
            <%- typeof heroContent !== 'undefined' && heroContent ? heroContent : 'Selamat datang di ruang tulisan pribadi saya.' %>
        </div>
    </header>

    <!-- Featured Post (Compact Card) -->
    <% if (featuredPosts && featuredPosts.length > 0) { %>
        <section class="mb-10">
            <div class="flex items-center justify-between pb-2 mb-4 border-b border-gray-100">
                <span class="text-xs font-bold uppercase tracking-wider text-emerald-800">Tulisan Utama</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <% featuredPosts.forEach(post => { %>
                    <article class="p-5 rounded-xl bg-emerald-50/50 border border-emerald-100 hover:border-emerald-300 transition duration-150 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center gap-2 text-[11px] text-emerald-800 font-medium mb-1.5">
                                <span class="px-2 py-0.5 rounded bg-white text-emerald-900 border border-emerald-200 font-semibold"><%= post.category %></span>
                                <span>•</span>
                                <span><%= new Date(post.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
                                <span>•</span>
                                <span><%= post.reading_time || 1 %> min read</span>
                            </div>
                            <h2 class="text-base sm:text-lg font-serif font-bold text-gray-900 mb-1.5 hover:text-emerald-800 transition leading-snug">
                                <a href="/blog/<%= post.slug %>"><%= post.title %></a>
                            </h2>
                            <p class="text-gray-600 text-xs sm:text-sm leading-relaxed line-clamp-2 mb-3">
                                <%= post.meta_description || post.content.replace(/<[^>]+>/g, '').substring(0, 130) + '...' %>
                            </p>
                        </div>
                        <a href="/blog/<%= post.slug %>" class="inline-flex items-center text-xs font-bold text-emerald-800 hover:text-emerald-900 gap-1">
                            Baca Selengkapnya →
                        </a>
                    </article>
                <% }) %>
            </div>
        </section>
    <% } %>

    <!-- Recent Articles (Compact Stream) -->
    <section>
        <div class="flex items-center justify-between pb-2.5 border-b border-gray-100 mb-4">
            <h2 class="text-base font-serif font-bold text-gray-900">Tulisan & Kajian Terbaru</h2>
            <a href="/blog" class="text-xs font-semibold text-emerald-800 hover:underline">
                Lihat Semua Arsip →
            </a>
        </div>

        <div class="divide-y divide-gray-100">
            <% if (recentPosts && recentPosts.length > 0) { %>
                <% recentPosts.forEach(post => { %>
                    <article class="py-4 first:pt-0 group">
                        <div class="flex items-center gap-2 text-xs text-gray-400 mb-1">
                            <span class="text-emerald-800 font-semibold"><%= post.category || 'Kajian' %></span>
                            <span>•</span>
                            <time datetime="<%= post.created_at %>"><%= new Date(post.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %></time>
                            <span>•</span>
                            <span><%= post.reading_time || 1 %> min read</span>
                        </div>

                        <h3 class="text-base sm:text-lg font-serif font-bold text-gray-900 mb-1 group-hover:text-emerald-800 transition leading-snug">
                            <a href="/blog/<%= post.slug %>">
                                <%= post.title %>
                            </a>
                        </h3>

                        <p class="text-gray-600 text-xs sm:text-sm leading-relaxed line-clamp-2 mb-2">
                            <%= post.meta_description || post.content.replace(/<[^>]+>/g, '').substring(0, 140) + '...' %>
                        </p>

                        <a href="/blog/<%= post.slug %>" class="inline-flex items-center text-xs font-semibold text-emerald-800 hover:underline">
                            Baca kajian →
                        </a>
                    </article>
                <% }) %>
            <% } else { %>
                <div class="text-center py-8 text-gray-400 text-xs">
                    Belum ada tulisan yang dipublikasikan.
                </div>
            <% } %>
        </div>

        <div class="mt-8 pt-4 border-t border-gray-100 text-center">
            <a href="/blog" class="inline-flex items-center px-5 py-2 rounded-lg border border-emerald-800 text-emerald-800 hover:bg-emerald-800 hover:text-white font-semibold text-xs transition">
                Buka Semua Arsip Tulisan (<%= totalPosts %> Artikel)
            </a>
        </div>
    </section>

</div>

<%- include('partials/footer') %>