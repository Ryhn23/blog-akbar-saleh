<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dasbor Admin | <%= siteName %>
    </title>
    <!-- Favicon -->
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png">
    <link rel="icon" href="/favicon/favicon.ico" type="image/x-icon">
    <link rel="manifest" href="/favicon/site.webmanifest">
    <link rel="stylesheet" href="/css/output.css?v=4">
</head>

<body class="bg-gray-50 font-sans min-h-screen flex flex-col text-gray-800">

    <!-- Admin Topbar (Clean Emerald Green) -->
    <nav class="bg-emerald-900 text-white shadow-sm">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <div class="flex items-center gap-2">
                    <span class="font-serif font-bold text-base">
                        <%= siteName %>
                    </span>
                    <span class="text-xs text-emerald-300 font-light">• Dasbor Pengelola</span>
                </div>
                <div class="flex items-center gap-4 text-xs font-medium">
                    <a href="/admin" class="text-white font-bold underline transition">Artikel</a>
                    <a href="/admin/categories" class="text-emerald-100 hover:text-white transition">Kategori</a>
                    <a href="/admin/comments" class="text-emerald-100 hover:text-white transition">Komentar</a>
                    <a href="/admin/about" class="text-emerald-100 hover:text-white transition">Tentang</a>
                    <a href="/admin/settings" class="text-emerald-100 hover:text-white transition">Pengaturan</a>
                    <a href="/" target="_blank" class="text-emerald-100 hover:text-white transition">Lihat Blog ↗</a>
                    <a href="/admin/logout"
                        class="bg-emerald-950 text-emerald-200 px-3 py-1.5 rounded hover:bg-black transition">Keluar</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content Area -->
    <main class="flex-grow max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">

        <!-- Header & Action -->
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
            <div>
                <h1 class="text-xl sm:text-2xl font-serif font-bold text-gray-900">Kelola Artikel & Tulisan</h1>
                <p class="text-xs text-gray-500 mt-0.5">Total <%= totalPosts %> artikel telah dipublikasikan.</p>
            </div>
            <a href="/admin/posts/new"
                class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-emerald-800 text-white text-xs font-semibold hover:bg-emerald-900 transition">
                + Tulis Artikel Baru
            </a>
        </div>

        <!-- Table Container -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
            <div
                class="p-4 border-b border-gray-100 flex flex-col sm:flex-row justify-between items-center gap-3 bg-gray-50/50">
                <span class="text-xs font-semibold text-gray-600">Daftar Artikel</span>
                <form action="/admin" method="GET" class="w-full sm:w-64">
                    <input type="text" name="q" value="<%= searchQuery %>" placeholder="Cari judul..."
                        class="w-full px-3 py-1.5 bg-white border border-gray-300 rounded text-xs focus:ring-1 focus:ring-emerald-700">
                </form>
            </div>

            <% if (posts.length> 0) { %>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr
                                class="bg-gray-50 border-b border-gray-200 text-gray-600 text-xs uppercase font-semibold">
                                <th class="p-3.5">Judul</th>
                                <th class="p-3.5">Kategori</th>
                                <th class="p-3.5">Status & Visibilitas</th>
                                <th class="p-3.5">Terjemahan AI</th>
                                <th class="p-3.5">Tanggal</th>
                                <th class="p-3.5 text-right">Aksi</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100 text-xs">
                            <% posts.forEach(post=> { %>
                                <tr class="hover:bg-gray-50 transition">
                                    <td class="p-3.5">
                                        <div class="font-semibold text-gray-900 mb-0.5">
                                            <%= post.title %>
                                                <% if (post.is_featured) { %>
                                                    <span
                                                        class="ml-1 px-1.5 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-800">Utama</span>
                                                <% } %>
                                                <% if (post.attachment_url) { %>
                                                    <span
                                                        class="ml-1 px-1.5 py-0.5 rounded text-[10px] font-bold bg-blue-50 text-blue-700">Lampiran</span>
                                                <% } %>
                                        </div>
                                        <div class="text-gray-400">/blog/<%= post.slug %>
                                        </div>
                                    </td>
                                    <td class="p-3.5">
                                        <span class="px-2 py-0.5 rounded bg-emerald-50 text-emerald-800 font-medium">
                                            <%= post.category || 'Umum' %>
                                        </span>
                                    </td>
                                    <td class="p-3.5 whitespace-nowrap">
                                        <div class="flex items-center gap-1.5 flex-wrap">
                                            <!-- Publish Status & Toggle -->
                                            <form action="/admin/posts/<%= post.id %>/toggle-publish" method="POST"
                                                class="inline-block" title="Klik untuk mengubah status Terbit / Draf">
                                                <% if (post.is_published===1) { %>
                                                    <button type="submit"
                                                        class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 hover:bg-emerald-200 transition cursor-pointer">
                                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                                                        Terbit
                                                    </button>
                                                <% } else { %>
                                                    <button type="submit"
                                                        class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800 hover:bg-amber-200 transition cursor-pointer">
                                                        <span class="w-1.5 h-1.5 rounded-full bg-amber-600"></span>
                                                        Draf
                                                    </button>
                                                <% } %>
                                            </form>

                                            <!-- Visibility Status & Toggle -->
                                            <form action="/admin/posts/<%= post.id %>/toggle-visibility" method="POST"
                                                class="inline-block"
                                                title="Klik untuk mengubah visibilitas Tampil / Sembunyikan">
                                                <% if (post.is_hidden===1) { %>
                                                    <button type="submit"
                                                        class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-gray-200 text-gray-700 hover:bg-gray-300 transition cursor-pointer">
                                                        <span>Sembunyi</span>
                                                    </button>
                                                <% } else { %>
                                                    <button type="submit"
                                                        class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-blue-50 text-blue-800 hover:bg-blue-100 transition cursor-pointer">
                                                        <span>Tampil</span>
                                                    </button>
                                                <% } %>
                                            </form>
                                        </div>
                                    </td>
                                    <td class="p-3.5 whitespace-nowrap">
                                        <div class="flex items-center gap-2">
                                            <% if (post.translationStatus && post.translationStatus.is_complete) { %>
                                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200" title="Terjemahan EN, AR, FA siap di database">
                                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                                                    Lengkap (EN, AR, FA)
                                                </span>
                                            <% } else if (post.translationStatus && post.translationStatus.is_processing) { %>
                                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-semibold bg-amber-50 text-amber-800 border border-amber-200 animate-pulse" title="Sedang diproses di latar belakang">
                                                    <span class="w-1.5 h-1.5 rounded-full bg-amber-600"></span>
                                                    Diproses...
                                                </span>
                                            <% } else { %>
                                                <div class="flex items-center gap-1">
                                                    <span class="px-1.5 py-0.5 rounded text-[10px] <%= (post.translationStatus && post.translationStatus.en) ? 'bg-emerald-100 text-emerald-800 font-bold' : 'bg-gray-100 text-gray-400' %>">EN</span>
                                                    <span class="px-1.5 py-0.5 rounded text-[10px] <%= (post.translationStatus && post.translationStatus.ar) ? 'bg-emerald-100 text-emerald-800 font-bold' : 'bg-gray-100 text-gray-400' %>">AR</span>
                                                    <span class="px-1.5 py-0.5 rounded text-[10px] <%= (post.translationStatus && post.translationStatus.fa) ? 'bg-emerald-100 text-emerald-800 font-bold' : 'bg-gray-100 text-gray-400' %>">FA</span>
                                                </div>
                                            <% } %>

                                            <form action="/admin/posts/<%= post.id %>/retranslate" method="POST" class="inline-block" title="Reset & Terjemahkan Ulang Otomatis">
                                                <button type="submit" class="p-1 rounded text-gray-400 hover:text-emerald-700 hover:bg-emerald-50 transition cursor-pointer" onclick="return confirm('Mulai ulang proses terjemahan untuk artikel ini?');">
                                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                                                    </svg>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                    <td class="p-3.5 text-gray-500 whitespace-nowrap">
                                        <%= new Date(post.created_at).toLocaleDateString('id-ID', { day: 'numeric' ,
                                            month: 'short' , year: 'numeric' }) %>
                                    </td>
                                    <td class="p-3.5 text-right space-x-2 whitespace-nowrap">
                                        <a href="/blog/<%= post.slug %>" target="_blank"
                                            class="text-gray-500 hover:text-gray-900">Lihat ↗</a>
                                        <span class="text-gray-300">|</span>
                                        <a href="/admin/posts/<%= post.id %>/edit"
                                            class="text-emerald-800 hover:underline font-semibold">Edit</a>
                                        <span class="text-gray-300">|</span>
                                        <form action="/admin/posts/<%= post.id %>/delete" method="POST"
                                            class="inline-block" onsubmit="return confirm('Hapus artikel ini?');">
                                            <button type="submit" class="text-red-600 hover:underline">Hapus</button>
                                        </form>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                </div>
                <% } else { %>
                    <div class="p-8 text-center text-gray-400 text-xs">
                        Belum ada tulisan. Silakan buat artikel pertama Anda.
                    </div>
                    <% } %>
        </div>
    </main>
</body>

</html>