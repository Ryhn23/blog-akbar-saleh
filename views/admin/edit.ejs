<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= post ? 'Edit Artikel' : 'Tulis Artikel Baru' %> | <%= siteName %> Admin
    </title>
    <!-- Favicon -->
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png">
    <link rel="icon" href="/favicon/favicon.ico" type="image/x-icon">
    <link rel="manifest" href="/favicon/site.webmanifest">
    <link rel="stylesheet" href="/css/output.css?v=4">
    <!-- Quill Snow CSS -->
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <style>
        .ql-editor {
            min-height: 400px;
            font-size: 16px;
            font-family: 'Merriweather', Georgia, serif;
            line-height: 1.8;
        }

        .ql-toolbar.ql-snow {
            border-top-left-radius: 0.5rem;
            border-top-right-radius: 0.5rem;
            border-color: #d1d5db;
            background: #f9fafb;
        }

        .ql-container.ql-snow {
            border-bottom-left-radius: 0.5rem;
            border-bottom-right-radius: 0.5rem;
            border-color: #d1d5db;
        }
    </style>
</head>

<body class="bg-gray-50 font-sans min-h-screen flex flex-col text-gray-800">

    <!-- Admin Topbar -->
    <nav class="bg-emerald-900 text-white shadow-sm">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <div class="flex items-center gap-2">
                    <span class="font-serif font-bold text-base">
                        <%= siteName %>
                    </span>
                    <span class="text-xs text-emerald-300 font-light">• Editor</span>
                </div>
                <a href="/admin" class="text-xs text-emerald-100 hover:text-white transition">
                    ← Kembali ke Dasbor
                </a>
            </div>
        </div>
    </nav>

    <!-- Main Form Area -->
    <main class="flex-grow max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">

        <div class="flex justify-between items-center mb-6">
            <h1 class="text-xl font-serif font-bold text-gray-900">
                <%= post && post.id ? 'Sunting Artikel' : 'Tulis Artikel Baru' %>
            </h1>
            <a href="/admin" class="text-xs text-gray-500 hover:text-gray-900">Batal</a>
        </div>

        <% if (typeof error !=='undefined' && error) { %>
            <div class="bg-red-50 text-red-700 p-3 rounded-lg mb-5 text-xs border border-red-200">
                <%= error %>
            </div>
            <% } %>

                <form action="<%= post && post.id ? '/admin/posts/' + post.id : '/admin/posts' %>" method="POST"
                    enctype="multipart/form-data"
                    class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 space-y-5" id="postForm">

                    <!-- Judul -->
                    <div>
                        <label for="title" class="block text-xs font-semibold text-gray-700 mb-1">Judul Artikel /
                            Kajian</label>
                        <input type="text" id="title" name="title" value="<%= post ? post.title : '' %>" required
                            placeholder="Judul tulisan..."
                            class="w-full px-3.5 py-2.5 bg-gray-50 border border-gray-300 rounded-lg focus:ring-1 focus:ring-emerald-700 focus:border-emerald-700 focus:bg-white text-base font-semibold">
                    </div>

                    <!-- Pengaturan Publikasi & Visibilitas Card -->
                    <div class="p-4 sm:p-5 rounded-xl bg-gray-50 border border-gray-200">
                        <div class="text-xs font-bold text-gray-900 mb-3 flex items-center justify-between">
                            <span>Status & Visibilitas Publikasi</span>
                            <span class="text-[11px] text-gray-400 font-normal">Atur apakah artikel langsung dapat
                                dibaca oleh pengunjung</span>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                            <!-- 1. Ceklis Publish / Terbitkan -->
                            <div
                                class="bg-white p-3.5 rounded-lg border border-gray-200 flex items-start gap-3 shadow-2xs">
                                <input type="checkbox" id="is_published" name="is_published" value="1" <%=(!post ||
                                    post.is_published===1) ? 'checked' : '' %> class="w-4 h-4 mt-0.5 text-emerald-800
                                rounded border-gray-300 focus:ring-emerald-700 cursor-pointer">
                                <div>
                                    <label for="is_published"
                                        class="block text-xs font-bold text-gray-800 cursor-pointer">
                                        Publikasikan
                                    </label>
                                    <p class="text-[11px] text-gray-500 mt-0.5 leading-tight">
                                        Hilangkan centang untuk menyimpan sebagai <strong>Draf</strong>.
                                    </p>
                                </div>
                            </div>

                            <!-- 2. Toggle Tampilkan / Sembunyikan Postingan -->
                            <div
                                class="bg-white p-3.5 rounded-lg border border-gray-200 flex items-start gap-3 shadow-2xs">
                                <input type="checkbox" id="is_hidden" name="is_hidden" value="1" <%=(post &&
                                    post.is_hidden===1) ? 'checked' : '' %> class="w-4 h-4 mt-0.5 text-amber-600 rounded
                                border-gray-300 focus:ring-amber-500 cursor-pointer">
                                <div>
                                    <label for="is_hidden" class="block text-xs font-bold text-gray-800 cursor-pointer">
                                        Sembunyikan Postingan
                                    </label>
                                    <p class="text-[11px] text-gray-500 mt-0.5 leading-tight">
                                        Sembunyikan dari arsip publik tanpa menghapus artikel.
                                    </p>
                                </div>
                            </div>

                            <!-- 3. Ceklis Tulisan Pilihan (Featured) -->
                            <div
                                class="bg-white p-3.5 rounded-lg border border-gray-200 flex items-start gap-3 shadow-2xs">
                                <input type="checkbox" id="is_featured" name="is_featured" value="1" <%=(post &&
                                    post.is_featured===1) ? 'checked' : '' %> class="w-4 h-4 mt-0.5 text-emerald-800
                                rounded border-gray-300 focus:ring-emerald-700 cursor-pointer">
                                <div>
                                    <label for="is_featured"
                                        class="block text-xs font-bold text-gray-800 cursor-pointer">
                                        Tulisan Pilihan
                                    </label>
                                    <p class="text-[11px] text-gray-500 mt-0.5 leading-tight">
                                        Tampilkan di bagian sorotan utama beranda.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <% if (post && post.id) { %>
                        <!-- Ollama Multi-Language AI Translation Card -->
                        <div class="p-4 sm:p-5 rounded-xl bg-emerald-50/60 border border-emerald-200">
                            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-3">
                                <div>
                                    <h4 class="text-xs font-bold text-emerald-950">
                                        Terjemahan AI Multi-Bahasa (Ollama Gemma 4:31B)
                                    </h4>
                                    <p class="text-[11px] text-gray-500 mt-0.5">Menerjemahkan judul, ringkasan, dan isi artikel untuk pembaca internasional (Inggris, Arab, Persia).</p>
                                </div>
                                <button type="button" id="btnTranslateAll" onclick="triggerOllamaTranslate('<%= post.id %>')" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-emerald-800 hover:bg-emerald-900 text-white text-xs font-semibold transition shadow-xs cursor-pointer">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                                    </svg>
                                    <span id="btnTranslateText">Terjemahkan via AI</span>
                                </button>
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs" id="translationStatusGrid">
                                <% const transMap = (typeof translations !== 'undefined' && translations) ? Object.fromEntries(translations.map(t => [t.lang_code, t])) : {}; %>
                                
                                <!-- English -->
                                <div class="bg-white p-3 rounded-lg border border-gray-200 flex items-center justify-between">
                                    <div>
                                        <span class="font-bold text-gray-900 block">English (EN)</span>
                                        <span class="text-[10px] text-gray-500"><%= transMap.en ? 'Tersedia' : 'Belum diterjemahkan' %></span>
                                    </div>
                                    <div class="flex items-center gap-1.5">
                                        <span class="px-2 py-0.5 rounded text-[10px] font-bold <%= transMap.en ? 'bg-emerald-100 text-emerald-800' : 'bg-gray-100 text-gray-500' %>">
                                            <%= transMap.en ? 'Siap' : 'Draf' %>
                                        </span>
                                        <button type="button" onclick="retranslateLanguage('<%= post.id %>', 'en')" class="p-1 rounded text-gray-400 hover:text-emerald-700 hover:bg-emerald-50 transition cursor-pointer" title="Terjemahkan / Reset Bahasa Inggris (EN)">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                                            </svg>
                                        </button>
                                    </div>
                                </div>

                                <!-- Arabic -->
                                <div class="bg-white p-3 rounded-lg border border-gray-200 flex items-center justify-between">
                                    <div>
                                        <span class="font-bold text-gray-900 block font-serif">العربية (AR)</span>
                                        <span class="text-[10px] text-gray-500"><%= transMap.ar ? 'Tersedia' : 'Belum diterjemahkan' %></span>
                                    </div>
                                    <div class="flex items-center gap-1.5">
                                        <span class="px-2 py-0.5 rounded text-[10px] font-bold <%= transMap.ar ? 'bg-emerald-100 text-emerald-800' : 'bg-gray-100 text-gray-500' %>">
                                            <%= transMap.ar ? 'Siap' : 'Draf' %>
                                        </span>
                                        <button type="button" onclick="retranslateLanguage('<%= post.id %>', 'ar')" class="p-1 rounded text-gray-400 hover:text-emerald-700 hover:bg-emerald-50 transition cursor-pointer" title="Terjemahkan / Reset Bahasa Arab (AR)">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                                            </svg>
                                        </button>
                                    </div>
                                </div>

                                <!-- Persian -->
                                <div class="bg-white p-3 rounded-lg border border-gray-200 flex items-center justify-between">
                                    <div>
                                        <span class="font-bold text-gray-900 block font-serif">فارسی (FA)</span>
                                        <span class="text-[10px] text-gray-500"><%= transMap.fa ? 'Tersedia' : 'Belum diterjemahkan' %></span>
                                    </div>
                                    <div class="flex items-center gap-1.5">
                                        <span class="px-2 py-0.5 rounded text-[10px] font-bold <%= transMap.fa ? 'bg-emerald-100 text-emerald-800' : 'bg-gray-100 text-gray-500' %>">
                                            <%= transMap.fa ? 'Siap' : 'Draf' %>
                                        </span>
                                        <button type="button" onclick="retranslateLanguage('<%= post.id %>', 'fa')" class="p-1 rounded text-gray-400 hover:text-emerald-700 hover:bg-emerald-50 transition cursor-pointer" title="Terjemahkan / Reset Bahasa Persia (FA)">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                                            </svg>
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div id="translateProgressMsg" class="hidden mt-2.5 text-[11px] text-emerald-800 font-medium"></div>
                        </div>
                    <% } %>

                    <!-- Kategori & Cover Image -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <div class="flex justify-between items-center mb-1">
                                <label for="category" class="block text-xs font-semibold text-gray-700">Kategori</label>
                                <a href="/admin/categories" target="_blank"
                                    class="text-[11px] text-emerald-800 hover:underline">+ Kelola Kategori</a>
                            </div>
                            <select id="category" name="category" required
                                class="w-full px-3 py-2 bg-gray-50 border border-gray-300 rounded-lg focus:ring-1 focus:ring-emerald-700 text-xs font-medium">
                                <% if (typeof categories !=='undefined' && categories && categories.length> 0) { %>
                                    <% categories.forEach(cat=> { %>
                                        <option value="<%= cat.name %>" <%=(post && post.category===cat.name)
                                            ? 'selected' : '' %>>
                                            <%= cat.name %>
                                        </option>
                                        <% }) %>
                                            <% } else { %>
                                                <option value="Kajian Keislaman" <%=(!post ||
                                                    post.category==='Kajian Keislaman' ) ? 'selected' : '' %>>Kajian
                                                    Keislaman</option>
                                                <option value="Artikel Ilmiah" <%=(post &&
                                                    post.category==='Artikel Ilmiah' ) ? 'selected' : '' %>>Artikel
                                                    Ilmiah</option>
                                                <option value="Opini & Pandangan" <%=(post &&
                                                    post.category==='Opini & Pandangan' ) ? 'selected' : '' %>>Opini &
                                                    Pandangan</option>
                                                <option value="Pendidikan Pesantren" <%=(post &&
                                                    post.category==='Pendidikan Pesantren' ) ? 'selected' : '' %>
                                                    >Pendidikan Pesantren</option>
                                                <% } %>
                            </select>
                        </div>

                        <!-- Cover Image -->
                        <div>
                            <label class="block text-xs font-semibold text-gray-700 mb-1">Gambar Sampul
                                (Opsional)</label>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                                <input type="file" name="cover_file" accept="image/*"
                                    class="w-full text-xs text-gray-500 file:mr-2 file:py-1 file:px-2.5 file:rounded file:border-0 file:text-xs file:font-semibold file:bg-emerald-50 file:text-emerald-800 hover:file:bg-emerald-100">
                                <input type="url" name="cover_url" placeholder="Atau URL gambar..."
                                    class="w-full px-2.5 py-1.5 bg-gray-50 border border-gray-300 rounded text-xs focus:ring-1 focus:ring-emerald-700">
                            </div>
                            <% if (post && post.cover_image) { %>
                                <input type="hidden" name="existing_cover" value="<%= post.cover_image %>">
                                <div class="mt-1 text-[11px] text-gray-500 truncate">Cover saat ini: <%=
                                        post.cover_image %>
                                </div>
                                <% } %>
                        </div>
                    </div>

                    <!-- Lampiran Dokumen (Attachment) -->
                    <div class="p-4 rounded-xl bg-gray-50 border border-gray-200">
                        <div class="flex items-center justify-between mb-2">
                            <label class="block text-xs font-bold text-gray-800">
                                Lampiran Dokumen (Opsional)
                            </label>
                            <span class="text-[11px] text-gray-400">PDF, DOCX, PPTX, XLSX, TXT, ZIP (Maks. 25MB)</span>
                        </div>
                        <p class="text-[11px] text-gray-500 mb-3">
                            Unggah naskah asli, PDF risalah, atau file pendukung lainnya. Pengunjung dapat mengunduh
                            file ini langsung di bawah artikel.
                        </p>
                        <input type="file" name="attachment_file"
                            accept=".pdf,.docx,.doc,.pptx,.ppt,.xlsx,.xls,.txt,.rtf,.zip,.rar,.7z,.odt,.ods,.odp"
                            class="w-full text-xs text-gray-500 file:mr-3 file:py-2 file:px-3.5 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-emerald-100 file:text-emerald-900 hover:file:bg-emerald-200 cursor-pointer">

                        <% if (post && post.attachment_url) { %>
                            <input type="hidden" name="existing_attachment_url" value="<%= post.attachment_url %>">
                            <input type="hidden" name="existing_attachment_name" value="<%= post.attachment_name %>">
                            <input type="hidden" name="existing_attachment_size" value="<%= post.attachment_size %>">

                            <div
                                class="mt-3 p-3 bg-white rounded-lg border border-gray-200 flex items-center justify-between">
                                <div class="flex items-center gap-2.5 overflow-hidden">
                                    <span class="p-1.5 rounded bg-emerald-50 text-emerald-800 shrink-0">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                        </svg>
                                    </span>
                                    <div class="min-w-0">
                                        <a href="<%= post.attachment_url %>" target="_blank"
                                            class="text-xs font-semibold text-emerald-900 hover:underline truncate block">
                                            <%= post.attachment_name || 'File Lampiran' %>
                                        </a>
                                        <% if (post.attachment_size) { %>
                                            <span class="text-[11px] text-gray-400">Ukuran: <%= (post.attachment_size /
                                                    (1024 * 1024)).toFixed(2) %> MB</span>
                                            <% } %>
                                    </div>
                                </div>

                                <label
                                    class="flex items-center gap-1.5 text-xs text-red-600 font-semibold cursor-pointer shrink-0 ml-3 hover:text-red-700">
                                    <input type="checkbox" name="delete_attachment" value="1"
                                        class="w-3.5 h-3.5 text-red-600 rounded border-gray-300 focus:ring-red-500">
                                    <span>Hapus File</span>
                                </label>
                            </div>
                            <% } %>
                    </div>

                    <!-- Ringkasan / Meta SEO -->
                    <div>
                        <label for="meta_description" class="block text-xs font-semibold text-gray-700 mb-1">Deskripsi
                            Ringkas / Abstrak</label>
                        <textarea id="meta_description" name="meta_description" rows="2" maxlength="200"
                            placeholder="Ringkasan singkat artikel..."
                            class="w-full px-3 py-2 bg-gray-50 border border-gray-300 rounded-lg text-xs focus:ring-1 focus:ring-emerald-700"><%= post ? post.meta_description : '' %></textarea>
                    </div>

                    <!-- Quill Content -->
                    <div>
                        <label class="block text-xs font-semibold text-gray-700 mb-1">Isi Artikel</label>
                        <div class="bg-white rounded-lg">
                            <div id="editor"><%- post ? post.content : '' %></div>
                        </div>
                        <input type="hidden" id="content" name="content">
                    </div>

                    <!-- Buttons -->
                    <div class="flex items-center justify-end gap-3 pt-4 border-t border-gray-100">
                        <a href="/admin"
                            class="px-4 py-2 rounded-lg border border-gray-300 text-gray-600 text-xs font-semibold hover:bg-gray-50">
                            Batal
                        </a>
                        <button type="submit"
                            class="px-5 py-2 rounded-lg bg-emerald-800 hover:bg-emerald-900 text-white text-xs font-semibold transition">
                            <%= post && post.id ? 'Simpan Perubahan' : 'Publikasikan' %>
                        </button>
                    </div>
                </form>
    </main>

    <!-- Hidden file input for Quill image handler -->
    <input type="file" id="quillImageInput" accept="image/*" style="display: none;">

    <!-- Quill JS -->
    <script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>
    <script>
        var quill = new Quill('#editor', {
            theme: 'snow',
            placeholder: 'Tuliskan teks kajian atau artikel di sini...',
            modules: {
                toolbar: [
                    [{ 'header': [1, 2, 3, false] }],
                    ['bold', 'italic', 'underline'],
                    [{ 'direction': 'rtl' }, { 'align': [] }],
                    ['blockquote', 'code-block'],
                    [{ 'list': 'ordered' }, { 'list': 'bullet' }],
                    ['link', 'image'],
                    ['clean']
                ]
            }
        });

        var toolbar = quill.getModule('toolbar');
        toolbar.addHandler('image', function () {
            var fileInput = document.getElementById('quillImageInput');
            fileInput.click();
            fileInput.onchange = function () {
                var file = fileInput.files[0];
                if (!file) return;

                var formData = new FormData();
                formData.append('image', file);

                fetch('/admin/upload-image', {
                    method: 'POST',
                    body: formData
                })
                    .then(function (res) { return res.json(); })
                    .then(function (data) {
                        if (data.success && data.url) {
                            var range = quill.getSelection(true);
                            quill.insertEmbed(range.index, 'image', data.url);
                        } else {
                            alert('Gagal unggah: ' + (data.message || 'Error'));
                        }
                    })
                    .catch(function (err) {
                        alert('Error: ' + err.message);
                    });
            };
        });

        document.getElementById('postForm').addEventListener('submit', function (e) {
            var content = document.querySelector('input[name=content]');
            if (content && quill) {
                content.value = quill.root.innerHTML;
            }
        });

        function retranslateLanguage(postId, lang) {
            var langNames = { en: 'Bahasa Inggris (EN)', ar: 'Bahasa Arab (AR)', fa: 'Bahasa Persia (FA)' };
            var langName = langNames[lang] || lang.toUpperCase();
            if (!confirm('Terjemahkan ulang versi ' + langName + ' saja?')) return;
            
            var form = document.createElement('form');
            form.method = 'POST';
            form.action = '/admin/posts/' + postId + '/retranslate';
            var input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'lang';
            input.value = lang;
            form.appendChild(input);
            document.body.appendChild(form);
            form.submit();
        }

        async function triggerOllamaTranslate(postId) {
            var btn = document.getElementById('btnTranslateAll');
            var btnText = document.getElementById('btnTranslateText');
            var msg = document.getElementById('translateProgressMsg');
            
            if (!confirm('Jalankan terjemahan AI Ollama (Gemma 4:31B) untuk bahasa Inggris, Arab, dan Persia?')) return;

            btn.disabled = true;
            btn.classList.add('opacity-50', 'cursor-not-allowed');
            btnText.textContent = 'Menerjemahkan...';
            if (msg) {
                msg.classList.remove('hidden');
                msg.textContent = 'Sedang memproses terjemahan via server Ollama... Harap tunggu beberapa detik.';
            }

            try {
                var response = await fetch('/admin/posts/' + postId + '/translate', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                var data = await response.json();
                if (data.success) {
                    alert('Berhasil! Artikel telah diterjemahkan ke bahasa Inggris, Arab, dan Persia.');
                    window.location.reload();
                } else {
                    alert('Gagal menerjemahkan: ' + (data.error || 'Terjadi kesalahan pada server AI.'));
                }
            } catch (err) {
                alert('Gagal menghubungi server: ' + err.message);
            } finally {
                btn.disabled = false;
                btn.classList.remove('opacity-50', 'cursor-not-allowed');
                btnText.textContent = 'Terjemahkan via AI';
                if (msg) msg.classList.add('hidden');
            }
        }
    </script>
</body>

</html>