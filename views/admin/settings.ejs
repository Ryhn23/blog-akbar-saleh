<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pengaturan Akun | <%= siteName %> Admin</title>
    <!-- Favicon -->
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png">
    <link rel="icon" href="/favicon/favicon.ico" type="image/x-icon">
    <link rel="manifest" href="/favicon/site.webmanifest">
    <link rel="stylesheet" href="/css/output.css?v=4">
</head>
<body class="bg-gray-50 font-sans min-h-screen flex flex-col text-gray-800">
    
    <!-- Admin Topbar -->
    <nav class="bg-emerald-900 text-white shadow-sm">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <div class="flex items-center gap-2">
                    <span class="font-serif font-bold text-base"><%= siteName %></span>
                    <span class="text-xs text-emerald-300 font-light">• Pengaturan</span>
                </div>
                <div class="flex items-center gap-4 text-xs font-medium">
                    <a href="/admin" class="text-emerald-100 hover:text-white transition">Artikel</a>
                    <a href="/admin/categories" class="text-emerald-100 hover:text-white transition">Kategori</a>
                    <a href="/admin/comments" class="text-emerald-100 hover:text-white transition">Komentar</a>
                    <a href="/admin/about" class="text-emerald-100 hover:text-white transition">Tentang</a>
                    <a href="/admin/settings" class="text-white font-bold underline transition">Pengaturan</a>
                    <a href="/" target="_blank" class="text-emerald-100 hover:text-white transition">Lihat Blog ↗</a>
                    <a href="/admin/logout" class="bg-emerald-950 text-emerald-200 px-3 py-1.5 rounded hover:bg-black transition">Keluar</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content Area -->
    <main class="flex-grow max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">
        
        <h1 class="text-xl font-serif font-bold text-gray-900 mb-6">Pengaturan Blog & Akun</h1>

        <% if (error) { %>
            <div class="bg-red-50 text-red-700 p-3 rounded-lg mb-5 text-xs border border-red-200">
                <%= error %>
            </div>
        <% } %>

        <% if (success) { %>
            <div class="bg-emerald-50 text-emerald-800 p-3 rounded-lg mb-5 text-xs border border-emerald-200">
                <%= success %>
            </div>
        <% } %>

        <!-- Homepage Hero Header Settings Card -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-6">
            <div class="flex items-center justify-between mb-2">
                <div>
                    <h2 class="text-sm font-bold text-gray-900">Tampilan Header Beranda (Hero Section)</h2>
                    <p class="text-xs text-gray-500">Sesuaikan teks bismillah, judul utama, dan kalimat pengantar di bagian atas halaman beranda.</p>
                </div>
                <a href="/" target="_blank" class="text-xs text-emerald-800 font-semibold hover:underline">
                    Lihat Beranda ↗
                </a>
            </div>
            
            <form action="/admin/settings/hero" method="POST" class="space-y-4 pt-2">
                <div>
                    <label for="hero_badge" class="block text-xs font-semibold text-gray-700 mb-1">Teks Badge (Bagian Atas)</label>
                    <input type="text" id="hero_badge" name="hero_badge" value="<%= homeHero ? (homeHero.subtitle || '') : 'بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ' %>" placeholder="بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ" class="w-full px-3 py-2 bg-gray-50 border border-gray-300 rounded-lg text-xs focus:ring-1 focus:ring-emerald-700">
                    <p class="text-[11px] text-gray-400 mt-1">Kosongkan jika tidak ingin menampilkan badge.</p>
                </div>

                <div>
                    <label for="hero_title" class="block text-xs font-semibold text-gray-700 mb-1">Judul Utama Beranda</label>
                    <textarea id="hero_title" name="hero_title" rows="2" required class="w-full px-3 py-2 bg-gray-50 border border-gray-300 rounded-lg text-sm font-serif font-bold text-gray-900 focus:ring-1 focus:ring-emerald-700"><%= homeHero ? (homeHero.title || '') : 'Catatan, Kajian Ilmiah & <span class="text-emerald-800">Pemikiran Keislaman</span>' %></textarea>
                    <p class="text-[11px] text-gray-400 mt-1">Gunakan tag HTML seperti <code class="text-emerald-800">&lt;span class="text-emerald-800"&gt;Teks Hijau&lt;/span&gt;</code> untuk memberi aksen warna.</p>
                </div>

                <div>
                    <label for="hero_content" class="block text-xs font-semibold text-gray-700 mb-1">Paragraf Pengantar</label>
                    <textarea id="hero_content" name="hero_content" rows="3" class="w-full px-3 py-2 bg-gray-50 border border-gray-300 rounded-lg text-xs leading-relaxed focus:ring-1 focus:ring-emerald-700"><%= homeHero ? (homeHero.content || '') : 'Selamat datang di ruang tulisan pribadi saya.' %></textarea>
                    <p class="text-[11px] text-gray-400 mt-1">Dapat menggunakan tag HTML seperti <code class="text-emerald-800">&lt;strong&gt;teks tebal&lt;/strong&gt;</code>.</p>
                </div>

                <div class="pt-2 flex justify-end">
                    <button type="submit" class="px-4 py-2 rounded-lg bg-emerald-800 hover:bg-emerald-900 text-white text-xs font-semibold transition shadow-xs">
                        Simpan Tampilan Beranda
                    </button>
                </div>
            </form>
        </div>

        <!-- Profile Settings Card -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-6">
            <h2 class="text-sm font-bold text-gray-900 mb-1">Informasi Penulis & Admin</h2>
            <p class="text-xs text-gray-500 mb-4">Email Google yang tertera di sini akan mendapatkan badge otomatis <strong>"Penulis Asli"</strong> saat memberikan tanggapan di artikel.</p>
            
            <form action="/admin/settings/profile" method="POST" class="space-y-3.5">
                <div>
                    <label for="name" class="block text-xs font-semibold text-gray-700 mb-1">Nama Lengkap & Gelar</label>
                    <input type="text" id="name" name="name" value="<%= user ? (user.name || '') : '' %>" required class="w-full px-3 py-2 bg-gray-50 border border-gray-300 rounded-lg text-xs focus:ring-1 focus:ring-emerald-700">
                </div>
                <div>
                    <label for="email" class="block text-xs font-semibold text-gray-700 mb-1">Email Google Resmi Penulis</label>
                    <input type="email" id="email" name="email" value="<%= user ? (user.email || '') : '' %>" placeholder="contoh: akbarsaleh@gmail.com" class="w-full px-3 py-2 bg-gray-50 border border-gray-300 rounded-lg text-xs focus:ring-1 focus:ring-emerald-700">
                    <p class="text-[11px] text-gray-400 mt-1">Akun Google dengan email ini dapat login langsung via tombol Google dan otomatis berstatus sebagai <strong>Penulis Asli</strong>.</p>
                </div>
                <div>
                    <label for="username" class="block text-xs font-semibold text-gray-700 mb-1">Nama Pengguna (Username Login Biasa)</label>
                    <input type="text" id="username" name="username" value="<%= user ? user.username : '' %>" required class="w-full px-3 py-2 bg-gray-50 border border-gray-300 rounded-lg text-xs focus:ring-1 focus:ring-emerald-700">
                </div>

                <!-- Google Connection Status -->
                <div class="pt-3 pb-1 border-t border-gray-100">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs">
                        <span class="text-gray-600 font-medium">Status Akun Google:</span>
                        <% if (user && (user.google_id || user.email)) { %>
                            <div class="flex items-center gap-2 flex-wrap">
                                <span class="inline-flex items-center gap-1.5 text-emerald-800 font-bold bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200">
                                    <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
                                    Terhubung (<%= user.email || user.google_id %>)
                                </span>
                            </div>
                        <% } else { %>
                            <span class="text-gray-400">Belum terhubung ke akun Google manapun.</span>
                        <% } %>
                    </div>
                </div>

                <div class="pt-2 flex items-center justify-between">
                    <div>
                        <% if (user && (user.google_id || user.email)) { %>
                            <button type="submit" form="form-unbind" class="text-xs text-red-600 hover:text-red-800 font-semibold underline cursor-pointer">
                                ✕ Putuskan Akun Google (Unbind)
                            </button>
                        <% } %>
                    </div>
                    <button type="submit" class="px-4 py-2 rounded-lg bg-emerald-800 hover:bg-emerald-900 text-white text-xs font-semibold transition shadow-xs">
                        Simpan Perubahan Profil
                    </button>
                </div>
            </form>

            <% if (user && (user.google_id || user.email)) { %>
                <form id="form-unbind" action="/admin/settings/unbind-google" method="POST" onsubmit="return confirm('Yakin ingin memutuskan/menghapus tautan akun Google ini dari akun Admin?');" class="hidden">
                </form>
            <% } %>
        </div>

        <!-- Password Change Card -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <h2 class="text-sm font-bold text-gray-900 mb-3">Ubah Kata Sandi Kredensial</h2>
            <form action="/admin/settings/password" method="POST" class="space-y-3.5">
                <div>
                    <label for="current_password" class="block text-xs font-semibold text-gray-700 mb-1">Kata Sandi Saat Ini</label>
                    <input type="password" id="current_password" name="current_password" required class="w-full px-3 py-2 bg-gray-50 border border-gray-300 rounded-lg text-xs focus:ring-1 focus:ring-emerald-700">
                </div>
                <div>
                    <label for="new_password" class="block text-xs font-semibold text-gray-700 mb-1">Kata Sandi Baru</label>
                    <input type="password" id="new_password" name="new_password" required minlength="6" class="w-full px-3 py-2 bg-gray-50 border border-gray-300 rounded-lg text-xs focus:ring-1 focus:ring-emerald-700">
                </div>
                <div>
                    <label for="confirm_password" class="block text-xs font-semibold text-gray-700 mb-1">Konfirmasi Kata Sandi Baru</label>
                    <input type="password" id="confirm_password" name="confirm_password" required minlength="6" class="w-full px-3 py-2 bg-gray-50 border border-gray-300 rounded-lg text-xs focus:ring-1 focus:ring-emerald-700">
                </div>
                <div class="pt-2 flex justify-end">
                    <button type="submit" class="px-4 py-2 rounded-lg bg-emerald-800 hover:bg-emerald-900 text-white text-xs font-semibold transition shadow-xs">
                        Perbarui Kata Sandi
                    </button>
                </div>
            </form>
        </div>

    </main>
</body>
</html>