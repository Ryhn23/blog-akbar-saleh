<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kelola Halaman Tentang | <%= siteName %> Admin</title>
    <!-- Favicon -->
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png">
    <link rel="icon" href="/favicon/favicon.ico" type="image/x-icon">
    <link rel="manifest" href="/favicon/site.webmanifest">
    <link rel="stylesheet" href="/css/output.css?v=4">
    <!-- Quill Snow CSS -->
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <style>
        .ql-editor { 
            min-height: 280px; 
            font-family: inherit; 
            font-size: 14px; 
            line-height: 1.7; 
        }
        .ql-toolbar.ql-snow {
            border-top-left-radius: 0.5rem;
            border-top-right-radius: 0.5rem;
            border-color: #d1d5db;
        }
        .ql-container.ql-snow {
            border-bottom-left-radius: 0.5rem;
            border-bottom-right-radius: 0.5rem;
            border-color: #d1d5db;
        }
    </style>
</head>
<body class="bg-gray-50 font-sans min-h-screen flex flex-col text-gray-800">
    
    <!-- Admin Topbar -->
    <nav class="bg-emerald-900 text-white shadow-sm">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <div class="flex items-center gap-2">
                    <span class="font-serif font-bold text-base"><%= siteName %></span>
                    <span class="text-xs text-emerald-300 font-light">• Halaman Tentang</span>
                </div>
                <div class="flex items-center gap-4 text-xs font-medium">
                    <a href="/admin" class="text-emerald-100 hover:text-white transition">Artikel</a>
                    <a href="/admin/categories" class="text-emerald-100 hover:text-white transition">Kategori</a>
                    <a href="/admin/comments" class="text-emerald-100 hover:text-white transition">Komentar</a>
                    <a href="/admin/about" class="text-white font-bold underline transition">Tentang</a>
                    <a href="/admin/settings" class="text-emerald-100 hover:text-white transition">Pengaturan</a>
                    <a href="/about" target="_blank" class="text-emerald-100 hover:text-white transition">Lihat Halaman ↗</a>
                    <a href="/admin/logout" class="bg-emerald-950 text-emerald-200 px-3 py-1.5 rounded hover:bg-black transition">Keluar</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content Area -->
    <main class="flex-grow max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">
        
        <div class="flex items-center justify-between mb-6">
            <div>
                <h1 class="text-xl font-serif font-bold text-gray-900">Kelola Konten Halaman "Tentang"</h1>
                <p class="text-xs text-gray-500 mt-1">Sunting profil, biografi, fokus riset, dan informasi pesantren yang tampil di halaman publik <code class="text-emerald-800 font-semibold">/about</code>.</p>
            </div>
            <a href="/about" target="_blank" class="text-xs font-semibold px-3 py-1.5 rounded-lg border border-gray-300 bg-white text-gray-700 hover:bg-emerald-50 hover:text-emerald-800 transition shadow-xs">
                Pratinjau Live ↗
            </a>
        </div>

        <% if (error) { %>
            <div class="bg-red-50 text-red-700 p-3 rounded-lg mb-5 text-xs border border-red-200">
                <%= error %>
            </div>
        <% } %>

        <% if (success) { %>
            <div class="bg-emerald-50 text-emerald-800 p-3 rounded-lg mb-5 text-xs border border-emerald-200">
                <%= success %>
            </div>
        <% } %>

        <form id="aboutForm" action="/admin/about" method="POST" class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 space-y-4">
            
            <div>
                <label for="title" class="block text-xs font-semibold text-gray-700 mb-1">Judul Utama Halaman</label>
                <input type="text" id="title" name="title" value="<%= page ? page.title : 'Tentang Penulis' %>" required class="w-full px-3 py-2 bg-gray-50 border border-gray-300 rounded-lg text-sm font-semibold focus:ring-1 focus:ring-emerald-700 focus:bg-white">
            </div>

            <div>
                <label for="subtitle" class="block text-xs font-semibold text-gray-700 mb-1">Subjudul / Peran / Jabatan</label>
                <input type="text" id="subtitle" name="subtitle" value="<%= page ? page.subtitle : '' %>" placeholder="Kyai & Pengasuh Pondok Pesantren Khatamun Nabiyyin Jakarta" class="w-full px-3 py-2 bg-gray-50 border border-gray-300 rounded-lg text-xs focus:ring-1 focus:ring-emerald-700 focus:bg-white">
            </div>

            <!-- Quill Editor for About Content -->
            <div>
                <label class="block text-xs font-semibold text-gray-700 mb-1">Isi Lengkap Profil & Biografi</label>
                <div class="bg-white rounded-lg">
                    <div id="editor"><%- page ? page.content : '' %></div>
                </div>
                <input type="hidden" id="content" name="content">
            </div>

            <!-- Buttons -->
            <div class="flex items-center justify-end gap-3 pt-4 border-t border-gray-100">
                <a href="/admin" class="px-4 py-2 rounded-lg border border-gray-300 text-gray-600 text-xs font-semibold hover:bg-gray-50">
                    Batal
                </a>
                <button type="submit" class="px-5 py-2 rounded-lg bg-emerald-800 hover:bg-emerald-900 text-white text-xs font-semibold transition shadow-sm">
                    Simpan Konten Tentang
                </button>
            </div>
        </form>
    </main>

    <!-- Hidden file input for Quill image handler -->
    <input type="file" id="quillImageInput" accept="image/*" style="display: none;">

    <!-- Quill JS -->
    <script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>
    <script>
        var quill = new Quill('#editor', {
            theme: 'snow',
            placeholder: 'Tuliskan biografi, profil, fokus kajian pesantren di sini...',
            modules: {
                toolbar: [
                    [{ 'header': [1, 2, 3, false] }],
                    ['bold', 'italic', 'underline'],
                    [{ 'direction': 'rtl' }, { 'align': [] }],
                    ['blockquote', 'code-block'],
                    [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                    ['link', 'image'],
                    ['clean']
                ]
            }
        });

        var toolbar = quill.getModule('toolbar');
        toolbar.addHandler('image', function() {
            var fileInput = document.getElementById('quillImageInput');
            fileInput.click();
            fileInput.onchange = function() {
                var file = fileInput.files[0];
                if (!file) return;

                var formData = new FormData();
                formData.append('image', file);

                fetch('/admin/upload-image', {
                    method: 'POST',
                    body: formData
                })
                .then(function(res) { return res.json(); })
                .then(function(data) {
                    if (data.success && data.url) {
                        var range = quill.getSelection(true);
                        quill.insertEmbed(range.index, 'image', data.url);
                    } else {
                        alert('Gagal unggah: ' + (data.message || 'Error'));
                    }
                })
                .catch(function(err) {
                    alert('Error: ' + err.message);
                });
            };
        });

        document.getElementById('aboutForm').onsubmit = function() {
            var content = document.querySelector('input[name=content]');
            content.value = quill.root.innerHTML;
        };
    </script>
</body>
</html>
