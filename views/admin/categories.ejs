<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kelola Kategori | <%= siteName %> Admin</title>
    <!-- Favicon -->
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png">
    <link rel="icon" href="/favicon/favicon.ico" type="image/x-icon">
    <link rel="manifest" href="/favicon/site.webmanifest">
    <link rel="stylesheet" href="/css/output.css?v=4">
</head>
<body class="bg-gray-50 font-sans min-h-screen flex flex-col text-gray-800">
    
    <!-- Admin Topbar -->
    <nav class="bg-emerald-900 text-white shadow-sm">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <div class="flex items-center gap-2">
                    <span class="font-serif font-bold text-base"><%= siteName %></span>
                    <span class="text-xs text-emerald-300 font-light">• Kategori</span>
                </div>
                <div class="flex items-center gap-4 text-xs font-medium">
                    <a href="/admin" class="text-emerald-100 hover:text-white transition">Artikel</a>
                    <a href="/admin/categories" class="text-white font-bold underline transition">Kategori</a>
                    <a href="/admin/comments" class="text-emerald-100 hover:text-white transition">Komentar</a>
                    <a href="/admin/about" class="text-emerald-100 hover:text-white transition">Tentang</a>
                    <a href="/admin/settings" class="text-emerald-100 hover:text-white transition">Pengaturan</a>
                    <a href="/" target="_blank" class="text-emerald-100 hover:text-white transition">Lihat Blog ↗</a>
                    <a href="/admin/logout" class="bg-emerald-950 text-emerald-200 px-3 py-1.5 rounded hover:bg-black transition">Keluar</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content Area -->
    <main class="flex-grow max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">
        
        <div class="flex justify-between items-center mb-6">
            <div>
                <h1 class="text-xl sm:text-2xl font-serif font-bold text-gray-900">Manajemen Kategori Tulisan</h1>
                <p class="text-xs text-gray-500 mt-0.5">Kelola dan tambahkan kategori custom untuk pilihan drop-down artikel.</p>
            </div>
            <a href="/admin/posts/new" class="inline-flex items-center gap-1 px-3 py-1.5 rounded bg-emerald-800 text-white text-xs font-semibold hover:bg-emerald-900 transition">
                + Tulis Artikel
            </a>
        </div>

        <% if (error) { %>
            <div class="bg-red-50 text-red-700 p-3 rounded-lg mb-5 text-xs border border-red-200">
                <%= error %>
            </div>
        <% } %>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Form Tambah Kategori Baru -->
            <div class="md:col-span-1">
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
                    <h2 class="text-sm font-bold text-gray-900 mb-3">Tambah Kategori Baru</h2>
                    <form action="/admin/categories" method="POST" class="space-y-3">
                        <div>
                            <label for="name" class="block text-xs font-semibold text-gray-700 mb-1">Nama Kategori</label>
                            <input type="text" id="name" name="name" required placeholder="misal: Fiqih Ibadah" class="w-full px-3 py-2 bg-gray-50 border border-gray-300 rounded-lg text-xs focus:ring-1 focus:ring-emerald-700 focus:bg-white">
                        </div>
                        <button type="submit" class="w-full py-2 bg-emerald-800 hover:bg-emerald-900 text-white font-semibold rounded-lg text-xs transition">
                            + Tambah Kategori
                        </button>
                    </form>
                </div>
            </div>

            <!-- Daftar Kategori -->
            <div class="md:col-span-2">
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                    <div class="p-3.5 border-b border-gray-100 bg-gray-50/50 flex justify-between items-center">
                        <span class="text-xs font-semibold text-gray-600">Daftar Kategori Aktif (<%= categories.length %>)</span>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse text-xs">
                            <thead>
                                <tr class="bg-gray-50 border-b border-gray-200 text-gray-600 uppercase font-semibold">
                                    <th class="p-3">Nama Kategori</th>
                                    <th class="p-3">Slug URL</th>
                                    <th class="p-3">Jumlah Tulisan</th>
                                    <th class="p-3 text-right">Aksi</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100">
                                <% categories.forEach(cat => { %>
                                    <tr class="hover:bg-gray-50 transition">
                                        <td class="p-3 font-semibold text-gray-900">
                                            <!-- Inline Edit Form -->
                                            <form action="/admin/categories/<%= cat.id %>/edit" method="POST" class="flex items-center gap-2">
                                                <input type="text" name="name" value="<%= cat.name %>" required class="px-2 py-1 bg-white border border-gray-200 rounded text-xs focus:ring-1 focus:ring-emerald-700 w-36">
                                                <button type="submit" class="text-emerald-800 hover:underline text-[11px] font-bold" title="Simpan Perubahan Nama">Simpan</button>
                                            </form>
                                        </td>
                                        <td class="p-3 text-gray-400 font-mono">
                                            <%= cat.slug %>
                                        </td>
                                        <td class="p-3 text-gray-600">
                                            <span class="px-2 py-0.5 rounded bg-emerald-50 text-emerald-800 font-bold">
                                                <%= cat.post_count || 0 %> artikel
                                            </span>
                                        </td>
                                        <td class="p-3 text-right space-x-2 whitespace-nowrap">
                                            <form action="/admin/categories/<%= cat.id %>/delete" method="POST" class="inline-block" onsubmit="return confirm('Hapus kategori <%= cat.name %>? Artikel terkait akan dialihkan ke kategori default.');">
                                                <button type="submit" class="text-red-600 hover:underline text-[11px]">Hapus</button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </main>
</body>
</html>
