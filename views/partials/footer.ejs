    </main>

    <!-- Harmonized Luxury Footer -->
    <footer class="bg-gradient-to-b from-[#0c2a38] to-[#061822] text-amber-100 border-t border-amber-500/20 mt-16 pt-12 pb-8">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col md:flex-row items-center justify-between gap-6 pb-8 border-b border-amber-500/15">
                
                <!-- Brand & Tagline -->
                <div class="flex flex-col items-center md:items-start text-center md:text-left">
                    <span class="font-serif font-bold text-xl sm:text-2xl text-amber-200 tracking-tight">
                        <%= siteName %>
                    </span>
                    <span class="text-xs text-amber-100/70 font-medium tracking-wide mt-0.5">
                        <%= siteTagline %>
                    </span>
                </div>

                <!-- Quick Navigation Links -->
                <nav class="flex items-center flex-wrap justify-center gap-4 sm:gap-6 text-xs font-semibold text-amber-100/90">
                    <a href="/<%= (typeof currentLang !== 'undefined' && currentLang !== 'id') ? '?lang=' + currentLang : '' %>" class="hover:text-amber-300 transition">
                        <%= typeof t !== 'undefined' ? t('nav_home') : 'Beranda' %>
                    </a>
                    <span>•</span>
                    <a href="/blog<%= (typeof currentLang !== 'undefined' && currentLang !== 'id') ? '?lang=' + currentLang : '' %>" class="hover:text-amber-300 transition">
                        <%= typeof t !== 'undefined' ? t('nav_blog') : 'Kajian & Tulisan' %>
                    </a>
                    <span>•</span>
                    <a href="/about<%= (typeof currentLang !== 'undefined' && currentLang !== 'id') ? '?lang=' + currentLang : '' %>" class="hover:text-amber-300 transition">
                        <%= typeof t !== 'undefined' ? t('nav_about') : 'Tentang' %>
                    </a>
                    <span>•</span>
                    <a href="/rss.xml" target="_blank" class="hover:text-amber-300 transition inline-flex items-center gap-1">
                        <span>RSS</span>
                    </a>
                </nav>
            </div>

            <!-- Copyright -->
            <div class="pt-6 flex justify-center items-center text-[11px] text-amber-200/50 text-center">
                <p>&copy; <%= new Date().getFullYear() %> <%= siteName %>. <%= typeof t !== 'undefined' ? t('copyright_notice') : 'Seluruh Hak Cipta Dilindungi.' %></p>
            </div>
        </div>
    </footer>

    <!-- Global Arabic Text, RTL & Continuous Blockquote Merger -->
    <script>
        (function () {
            function formatArabicContent() {
                const arabicRegex = /[\u0600-\u06FF\u0750-\u077F\u08A0-\u08FF\uFB50-\uFDFF\uFE70-\uFEFF]/;
                
                document.querySelectorAll('.quill-content').forEach(function (container) {
                    // 1. Merge adjacent/consecutive blockquotes
                    const bqs = Array.from(container.querySelectorAll('blockquote'));
                    for (let i = 0; i < bqs.length; i++) {
                        const currentBq = bqs[i];
                        if (!currentBq.parentNode) continue;
                        
                        let next = currentBq.nextElementSibling;
                        while (next && next.tagName && next.tagName.toLowerCase() === 'blockquote') {
                            const nextSibling = next.nextElementSibling;
                            while (next.firstChild) {
                                currentBq.appendChild(next.firstChild);
                            }
                            next.remove();
                            next = nextSibling;
                        }
                    }

                    // 2. Normalize and classify lines inside all blockquotes
                    container.querySelectorAll('blockquote').forEach(function (bq) {
                        const rawLines = [];
                        bq.childNodes.forEach(function (child) {
                            if (child.nodeType === Node.ELEMENT_NODE && (child.tagName.toLowerCase() === 'p' || child.tagName.toLowerCase() === 'div')) {
                                const t = child.innerHTML.trim();
                                if (t) rawLines.push(t);
                            } else if (child.nodeType === Node.TEXT_NODE) {
                                const t = child.textContent.trim();
                                if (t) rawLines.push(t);
                            } else if (child.nodeType === Node.ELEMENT_NODE && child.tagName.toLowerCase() !== 'br') {
                                const t = child.outerHTML.trim();
                                if (t) rawLines.push(t);
                            }
                        });

                        if (rawLines.length > 0) {
                            bq.innerHTML = '';
                            rawLines.forEach(function (lineHtml) {
                                const p = document.createElement('p');
                                p.innerHTML = lineHtml;
                                const text = p.textContent.trim();
                                if (!text) return;

                                let arabicCount = 0;
                                let latinCount = 0;
                                for (let c = 0; c < text.length; c++) {
                                    if (arabicRegex.test(text[c])) arabicCount++;
                                    else if (/[a-zA-Z]/.test(text[c])) latinCount++;
                                }

                                if (arabicCount > 0 && (latinCount === 0 || arabicCount >= latinCount * 0.5)) {
                                    p.className = 'arabic-text';
                                    p.setAttribute('dir', 'rtl');
                                } else if ((text.startsWith('(') && text.endsWith(')')) || text.startsWith('QS.') || text.startsWith('Surat') || text.includes('Nahj al-')) {
                                    p.className = 'quote-citation';
                                    p.setAttribute('dir', 'ltr');
                                } else {
                                    p.className = 'latin-text';
                                    p.setAttribute('dir', 'ltr');
                                }
                                bq.appendChild(p);
                            });
                        }
                    });

                    // 3. Process standalone elements outside blockquotes
                    container.querySelectorAll(':scope > p, :scope > div, :scope > h1, :scope > h2, :scope > h3, :scope > h4, :scope > li').forEach(function (el) {
                        const text = el.textContent.trim();
                        if (!text) return;

                        let arabicCount = 0;
                        let latinCount = 0;
                        for (let c = 0; c < text.length; c++) {
                            if (arabicRegex.test(text[c])) arabicCount++;
                            else if (/[a-zA-Z]/.test(text[c])) latinCount++;
                        }

                        if (arabicCount > 0 && (latinCount === 0 || arabicCount >= latinCount * 0.5)) {
                            el.classList.add('arabic-text');
                            el.classList.remove('ql-align-center', 'text-center');
                            el.setAttribute('dir', 'rtl');
                        }
                    });
                });
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', formatArabicContent);
            } else {
                formatArabicContent();
            }
        })();
    </script>
</body>
</html>
