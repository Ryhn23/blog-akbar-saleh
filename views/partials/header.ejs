<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' && title ? title + ' — ' + siteName : siteName + ' — ' + siteTagline %></title>
    <meta name="description" content="<%= typeof meta_description !== 'undefined' && meta_description ? meta_description : siteDescription %>">
    <meta name="author" content="<%= authorName %>">
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">

    <!-- Canonical URL -->
    <link rel="canonical" href="<%= typeof canonicalUrl !== 'undefined' && canonicalUrl ? canonicalUrl : (appUrl + (typeof currentPath !== 'undefined' ? currentPath : '')) %>">

    <!-- RSS Feed Auto-Discovery -->
    <link rel="alternate" type="application/rss+xml" title="RSS Feed <%= siteName %>" href="/rss.xml">

    <!-- Favicon -->
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png">
    <link rel="icon" href="/favicon/favicon.ico" type="image/x-icon">
    <link rel="manifest" href="/favicon/site.webmanifest">
    
    <!-- OpenGraph Meta Tags -->
    <meta property="og:locale" content="id_ID">
    <meta property="og:site_name" content="<%= siteName %>">
    <meta property="og:type" content="<%= typeof isArticle !== 'undefined' && isArticle ? 'article' : 'website' %>">
    <meta property="og:title" content="<%= typeof title !== 'undefined' && title ? title + ' — ' + siteName : siteName + ' — ' + siteTagline %>">
    <meta property="og:description" content="<%= typeof meta_description !== 'undefined' && meta_description ? meta_description : siteDescription %>">
    <meta property="og:url" content="<%= typeof canonicalUrl !== 'undefined' && canonicalUrl ? canonicalUrl : (appUrl + (typeof currentPath !== 'undefined' ? currentPath : '')) %>">
    <% if (typeof ogImage !== 'undefined' && ogImage) { %>
    <meta property="og:image" content="<%= ogImage.startsWith('http') ? ogImage : appUrl + ogImage %>">
    <% } else { %>
    <meta property="og:image" content="<%= appUrl %>/favicon/android-chrome-512x512.png">
    <% } %>

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= typeof title !== 'undefined' && title ? title + ' — ' + siteName : siteName + ' — ' + siteTagline %>">
    <meta name="twitter:description" content="<%= typeof meta_description !== 'undefined' && meta_description ? meta_description : siteDescription %>">
    <% if (typeof ogImage !== 'undefined' && ogImage) { %>
    <meta name="twitter:image" content="<%= ogImage.startsWith('http') ? ogImage : appUrl + ogImage %>">
    <% } else { %>
    <meta name="twitter:image" content="<%= appUrl %>/favicon/android-chrome-512x512.png">
    <% } %>

    <!-- Schema.org JSON-LD Structured Data -->
    <% if (typeof schemaJsonLd !== 'undefined' && schemaJsonLd) { %>
    <script type="application/ld+json">
        <%- JSON.stringify(schemaJsonLd) %>
    </script>
    <% } %>

    <link rel="stylesheet" href="/css/output.css?v=4">
</head>
<body class="bg-white text-gray-800 antialiased selection:bg-emerald-700 selection:text-white min-h-screen flex flex-col font-sans">
    
    <!-- Header / Navbar: Clean Green & White -->
    <header class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-gray-100 transition-all duration-200">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                
                <!-- Brand Title -->
                <a href="/<%= (typeof currentLang !== 'undefined' && currentLang !== 'id') ? '?lang=' + currentLang : '' %>" class="group flex flex-col">
                    <span class="font-serif font-bold text-xl sm:text-2xl text-emerald-900 tracking-tight group-hover:text-emerald-700 transition-colors">
                        <%= siteName %>
                    </span>
                    <span class="text-xs text-gray-500 font-medium tracking-wide">
                        <%= siteTagline %>
                    </span>
                </a>

                <!-- Desktop Navigation Links & Language Switcher -->
                <nav class="hidden sm:flex items-center space-x-6">
                    <a href="/<%= (typeof currentLang !== 'undefined' && currentLang !== 'id') ? '?lang=' + currentLang : '' %>" class="text-sm font-medium transition-colors <%= currentPath === '/' ? 'text-emerald-800 font-semibold border-b-2 border-emerald-700 pb-0.5' : 'text-gray-600 hover:text-emerald-800' %>">
                        <%= typeof t !== 'undefined' ? t('nav_home') : 'Beranda' %>
                    </a>
                    <a href="/blog<%= (typeof currentLang !== 'undefined' && currentLang !== 'id') ? '?lang=' + currentLang : '' %>" class="text-sm font-medium transition-colors <%= currentPath.startsWith('/blog') ? 'text-emerald-800 font-semibold border-b-2 border-emerald-700 pb-0.5' : 'text-gray-600 hover:text-emerald-800' %>">
                        <%= typeof t !== 'undefined' ? t('nav_blog') : 'Kajian & Tulisan' %>
                    </a>
                    <a href="/about<%= (typeof currentLang !== 'undefined' && currentLang !== 'id') ? '?lang=' + currentLang : '' %>" class="text-sm font-medium transition-colors <%= currentPath === '/about' ? 'text-emerald-800 font-semibold border-b-2 border-emerald-700 pb-0.5' : 'text-gray-600 hover:text-emerald-800' %>">
                        <%= typeof t !== 'undefined' ? t('nav_about') : 'Tentang' %>
                    </a>

                    <!-- Multi-Language Switcher (ID | EN | AR | FA) -->
                    <div class="relative inline-block text-left" id="lang-dropdown-wrapper">
                        <button type="button" onclick="toggleLangDropdown(event)" class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg border border-gray-200 bg-white hover:bg-emerald-50 hover:border-emerald-200 text-xs font-semibold text-gray-700 shadow-2xs transition cursor-pointer">
                            <svg class="w-3.5 h-3.5 text-emerald-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"/>
                            </svg>
                            <span class="uppercase"><%= typeof currentLang !== 'undefined' ? currentLang : 'ID' %></span>
                            <svg class="w-3 h-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                            </svg>
                        </button>
                        <div id="lang-menu" class="hidden absolute right-0 mt-1.5 w-36 rounded-xl bg-white border border-gray-200 shadow-lg py-1 z-50 text-xs font-medium">
                            <a href="javascript:void(0)" onclick="switchLanguage('id')" class="flex items-center justify-between px-3 py-2 hover:bg-emerald-50 hover:text-emerald-900 transition <%= (typeof currentLang === 'undefined' || currentLang === 'id') ? 'text-emerald-800 font-bold bg-emerald-50/50' : 'text-gray-700' %>">
                                <span>Indonesia</span>
                                <span class="text-[10px] text-gray-400 font-mono">ID</span>
                            </a>
                            <a href="javascript:void(0)" onclick="switchLanguage('en')" class="flex items-center justify-between px-3 py-2 hover:bg-emerald-50 hover:text-emerald-900 transition <%= (typeof currentLang !== 'undefined' && currentLang === 'en') ? 'text-emerald-800 font-bold bg-emerald-50/50' : 'text-gray-700' %>">
                                <span>English</span>
                                <span class="text-[10px] text-gray-400 font-mono">EN</span>
                            </a>
                            <a href="javascript:void(0)" onclick="switchLanguage('ar')" class="flex items-center justify-between px-3 py-2 hover:bg-emerald-50 hover:text-emerald-900 transition <%= (typeof currentLang !== 'undefined' && currentLang === 'ar') ? 'text-emerald-800 font-bold bg-emerald-50/50' : 'text-gray-700' %>">
                                <span class="font-serif">العربية</span>
                                <span class="text-[10px] text-gray-400 font-mono">AR</span>
                            </a>
                            <a href="javascript:void(0)" onclick="switchLanguage('fa')" class="flex items-center justify-between px-3 py-2 hover:bg-emerald-50 hover:text-emerald-900 transition <%= (typeof currentLang !== 'undefined' && currentLang === 'fa') ? 'text-emerald-800 font-bold bg-emerald-50/50' : 'text-gray-700' %>">
                                <span class="font-serif">فارسی</span>
                                <span class="text-[10px] text-gray-400 font-mono">FA</span>
                            </a>
                        </div>
                    </div>

                    <% if (isLoggedIn) { %>
                        <a href="/admin" class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-emerald-800 text-white hover:bg-emerald-900 transition">
                            <%= typeof t !== 'undefined' ? t('nav_dashboard') : 'Dasbor' %>
                        </a>
                    <% } %>
                </nav>

                <!-- Mobile Menu Button & Language Switcher -->
                <div class="flex items-center sm:hidden gap-2">
                    <div class="relative inline-block text-left" id="lang-dropdown-wrapper-mobile">
                        <button type="button" onclick="toggleLangDropdownMobile(event)" class="inline-flex items-center gap-1 px-2 py-1 rounded-md border border-gray-200 bg-white text-xs font-semibold text-gray-700">
                            <span class="uppercase"><%= typeof currentLang !== 'undefined' ? currentLang : 'ID' %></span>
                            <svg class="w-2.5 h-2.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                            </svg>
                        </button>
                        <div id="lang-menu-mobile" class="hidden absolute right-0 mt-1.5 w-32 rounded-xl bg-white border border-gray-200 shadow-lg py-1 z-50 text-xs font-medium">
                            <a href="javascript:void(0)" onclick="switchLanguage('id')" class="block px-3 py-1.5 hover:bg-emerald-50">Indonesia (ID)</a>
                            <a href="javascript:void(0)" onclick="switchLanguage('en')" class="block px-3 py-1.5 hover:bg-emerald-50">English (EN)</a>
                            <a href="javascript:void(0)" onclick="switchLanguage('ar')" class="block px-3 py-1.5 hover:bg-emerald-50">العربية (AR)</a>
                            <a href="javascript:void(0)" onclick="switchLanguage('fa')" class="block px-3 py-1.5 hover:bg-emerald-50">فارسی (FA)</a>
                        </div>
                    </div>

                    <button type="button" class="p-2 rounded-lg text-gray-600 hover:text-emerald-800 hover:bg-emerald-50 focus:outline-none" aria-label="Toggle menu" onclick="document.getElementById('mobile-menu').classList.toggle('hidden')">
                        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                        </svg>
                    </button>
                </div>
            </div>
        </div>

        <!-- Global Translation Loading Overlay (Minimal Spinner) -->
        <div id="ai-translate-modal" class="fixed inset-0 z-[99999] flex items-center justify-center bg-white/70 backdrop-blur-xs hidden transition-opacity duration-200">
            <div class="flex items-center justify-center p-4 rounded-2xl bg-white shadow-xl border border-gray-100">
                <svg class="animate-spin h-7 w-7 text-emerald-800" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-20" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-80" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
                </svg>
            </div>
        </div>

        <script>
        function toggleLangDropdown(e) {
            if (e) e.stopPropagation();
            const menu = document.getElementById('lang-menu');
            if (menu) menu.classList.toggle('hidden');
        }

        function toggleLangDropdownMobile(e) {
            if (e) e.stopPropagation();
            const menu = document.getElementById('lang-menu-mobile');
            if (menu) menu.classList.toggle('hidden');
        }

        function showTranslationLoader() {
            const modal = document.getElementById('ai-translate-modal');
            if (modal) modal.classList.remove('hidden');
        }

        function switchLanguage(langCode) {
            const current = '<%= typeof currentLang !== "undefined" ? currentLang : "id" %>';
            if (langCode === current) return;

            showTranslationLoader();

            // Persist language choice in Cookie (1 year) and LocalStorage
            document.cookie = "app_lang=" + encodeURIComponent(langCode) + "; path=/; max-age=31536000; SameSite=Lax";
            try {
                localStorage.setItem('app_lang', langCode);
            } catch (e) {}

            setTimeout(() => {
                const url = new URL(window.location.href);
                url.searchParams.set('lang', langCode);
                window.location.href = url.toString();
            }, 100);
        }

        document.addEventListener('click', function(e) {
            const wrapper = document.getElementById('lang-dropdown-wrapper');
            const menu = document.getElementById('lang-menu');
            if (menu && wrapper && !wrapper.contains(e.target)) {
                menu.classList.add('hidden');
            }
            const wrapperMobile = document.getElementById('lang-dropdown-wrapper-mobile');
            const menuMobile = document.getElementById('lang-menu-mobile');
            if (menuMobile && wrapperMobile && !wrapperMobile.contains(e.target)) {
                menuMobile.classList.add('hidden');
            }
        });
        </script>

        <!-- Mobile Menu Dropdown -->
        <div class="sm:hidden hidden bg-white border-b border-gray-100 px-4 pt-2 pb-4 space-y-2" id="mobile-menu">
            <a href="/<%= (typeof currentLang !== 'undefined' && currentLang !== 'id') ? '?lang=' + currentLang : '' %>" class="block px-3 py-2 rounded-lg text-sm font-medium <%= currentPath === '/' ? 'text-emerald-800 bg-emerald-50 font-bold' : 'text-gray-700 hover:bg-gray-50' %>"><%= typeof t !== 'undefined' ? t('nav_home') : 'Beranda' %></a>
            <a href="/blog<%= (typeof currentLang !== 'undefined' && currentLang !== 'id') ? '?lang=' + currentLang : '' %>" class="block px-3 py-2 rounded-lg text-sm font-medium <%= currentPath.startsWith('/blog') ? 'text-emerald-800 bg-emerald-50 font-bold' : 'text-gray-700 hover:bg-gray-50' %>"><%= typeof t !== 'undefined' ? t('nav_blog') : 'Kajian & Tulisan' %></a>
            <a href="/about<%= (typeof currentLang !== 'undefined' && currentLang !== 'id') ? '?lang=' + currentLang : '' %>" class="block px-3 py-2 rounded-lg text-sm font-medium <%= currentPath === '/about' ? 'text-emerald-800 bg-emerald-50 font-bold' : 'text-gray-700 hover:bg-gray-50' %>"><%= typeof t !== 'undefined' ? t('nav_about') : 'Tentang' %></a>
            <% if (isLoggedIn) { %>
                <a href="/admin" class="block px-3 py-2 rounded-lg text-sm font-semibold text-emerald-800 bg-emerald-100"><%= typeof t !== 'undefined' ? t('nav_dashboard') : 'Dasbor Admin' %></a>
            <% } %>
        </div>
    </header>

    <!-- Main Body Container -->
    <main class="flex-grow">
