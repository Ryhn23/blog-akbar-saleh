# ==============================================================================
# Blog Akbar Saleh - Production Environment Configuration
# ==============================================================================

# Server Configuration
PORT=7842
NODE_ENV=production
APP_URL=https://khatamunnabiyyin.com

# Reverse Proxy & SSL (Set TRUST_PROXY=true when running behind Nginx/Cloudflare)
TRUST_PROXY=true
COOKIE_SECURE=false

# Security & Session Secret (Ganti dengan string random yang kuat di production)
SESSION_SECRET=akbar-saleh-blog-super-secret-key-change-this-in-production
ALLOWED_ORIGINS=*

# Database Path
DATABASE_PATH=./data/database.sqlite

# Default Admin Credentials (Auto-created on first run if database empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Profile & Metadata
SITE_NAME=Akbar Saleh
SITE_TAGLINE=Kajian & Pemikiran Keislaman
SITE_DESCRIPTION=Ruang publikasi artikel ilmiah, studi keislaman, opini, dan catatan pemikiran oleh Akbar Saleh, B.A., Pengasuh Pondok Pesantren Khatamun Nabiyyin Jakarta.
AUTHOR_NAME=Akbar Saleh, B.A.
AUTHOR_ROLE=Kyai & Pengasuh Pondok Pesantren Khatamun Nabiyyin Jakarta
AUTHOR_BIO=Kyai dan Pengasuh Pondok Pesantren Khatamun Nabiyyin Jakarta. Menulis seputar studi keislaman, riset keilmuan, dan analisis sosial keagamaan.
AUTHOR_LOCATION=Jakarta, Indonesia
AUTHOR_EMAIL=akbarsaleh@khatamunnabiyyin.com

# Google OAuth 2.0 (For Reader Comments & Verified Author Badges)
# Dapatkan dari Google Cloud Console: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://khatamunnabiyyin.com/auth/google/callback
ADMIN_GOOGLE_EMAIL=akbarsaleh@khatamunnabiyyin.com
