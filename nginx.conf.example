# ==============================================================================
# Nginx Server Block: Blog Akbar Saleh
# Letakkan konfigurasi ini di /etc/nginx/sites-available/blog-akbar-saleh
# Lalu buat symlink: sudo ln -s /etc/nginx/sites-available/blog-akbar-saleh /etc/nginx/sites-enabled/
# ==============================================================================

# Redirect HTTP to HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name yourdomain.com www.yourdomain.com; # Ganti dengan domain Anda

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS Configuration (Setelah mendapatkan sertifikat SSL Let's Encrypt via Certbot)
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name yourdomain.com www.yourdomain.com; # Ganti dengan domain Anda

    # SSL Certificate Paths (dihasilkan oleh certbot)
    ssl_certificate /etc/letsencrypt/live/yourdomain.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/yourdomain.com/privkey.pem;

    # SSL Hardening & Modern Protocols
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # Security Headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Client Request Size (sesuaikan untuk upload file/gambar hingga 25MB)
    client_max_body_size 30M;

    # Reverse Proxy to Docker Container / Node.js Express App
    location / {
        proxy_pass http://127.0.0.1:7842;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 60s;
        proxy_connect_timeout 60s;
    }
}
