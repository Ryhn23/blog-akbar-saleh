# Git & Version Control
.git/
.gitignore

# Dependencies (Installed cleanly in container build via npm ci)
node_modules/

# Environment Variables & Secrets
.env
.env.*
!.env.example

# Local Database & Storage (Mounted at runtime via docker-compose volumes)
data/
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.db

# User Uploads (Mounted at runtime via docker-compose volumes)
public/uploads/*
!public/uploads/.gitkeep

# Logs & Temporary Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.DS_Store
*.tmp
*.temp
test_*.pdf

# Documentation & Config Examples (Not needed inside production image)
DEPLOYMENT_GUIDE.md
nginx.conf.example
